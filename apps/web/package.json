{
  "name": "@lp-platform/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate-i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie baseLocale --silent",
    "generate": "pnpm generate-routes && pnpm generate-i18n",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:dev",
    "@tanstack/devtools-vite": "catalog:dev",
    "@tanstack/router-cli": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "^5.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start"
    ]
  }
}
