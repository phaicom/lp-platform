{
  "name": "lp-platform",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "author": "Reawpai Chunsoi",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev",
    "nano-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
